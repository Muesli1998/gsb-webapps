{
  "repo": "C:\\Users\\Christoffer\\Code\\gsb-webapps",
  "tools": {
    "git_status": {
      "beskrivelse": "git status --short (alle filer, ikke kun mapper)",
      "trin": [
        {
          "cmd": "git",
          "args": [
            "status",
            "--short",
            "--untracked-files=all"
          ]
        }
      ]
    },
    "git_gren": {
      "beskrivelse": "Vis aktuel gren",
      "trin": [
        {
          "cmd": "git",
          "args": [
            "branch",
            "--show-current"
          ]
        }
      ]
    },
    "git_diff_check": {
      "beskrivelse": "git diff --check (blanktegn-fejl)",
      "trin": [
        {
          "cmd": "git",
          "args": [
            "diff",
            "--check"
          ]
        }
      ]
    },
    "git_diff_stat": {
      "beskrivelse": "git diff --stat (hvad er ændret, ikke committet)",
      "trin": [
        {
          "cmd": "git",
          "args": [
            "diff",
            "--stat"
          ]
        }
      ]
    },
    "git_log": {
      "beskrivelse": "De seneste commits, en linje hver",
      "parametre": {
        "antal": {
          "moenster": "^\\d{1,2}$",
          "paakraevet": true,
          "beskrivelse": "1-99"
        }
      },
      "trin": [
        {
          "cmd": "git",
          "args": [
            "log",
            "--oneline",
            "-n",
            "{antal}"
          ]
        }
      ]
    },
    "git_add": {
      "beskrivelse": "git add med eksplicitte stier (ingen jokertegn, ingen -A)",
      "parametre": {
        "stier": {
          "type": "stier",
          "paakraevet": true
        }
      },
      "trin": [
        {
          "cmd": "git",
          "args": [
            "add",
            "--",
            "{stier*}"
          ]
        }
      ],
      "skriver": true
    },
    "git_commit": {
      "beskrivelse": "git commit -m med en enkelt linje. Ingen Co-Authored-By.",
      "parametre": {
        "besked": {
          "moenster": "^[^\\r\\n]{5,200}$",
          "forbyd": "co-authored-by",
          "paakraevet": true
        }
      },
      "trin": [
        {
          "cmd": "git",
          "args": [
            "commit",
            "-m",
            "{besked}"
          ]
        }
      ],
      "skriver": true,
      "forkontrol": [
        "ingen_netlify_staged"
      ]
    },
    "git_gendan_fil": {
      "beskrivelse": "git restore -- <stier>: kasserer ALLE ikke-committede ændringer i de angivne filer (kan ikke fortrydes). Aldrig apps/netlify-prod/. Tjek git_diff_stat først.",
      "parametre": {
        "stier": {
          "type": "stier",
          "paakraevet": true
        }
      },
      "trin": [
        {
          "cmd": "git",
          "args": [
            "restore",
            "--",
            "{stier*}"
          ]
        }
      ],
      "skriver": true
    },
    "git_flet_gren": {
      "beskrivelse": "Skift til main, flet grenen med --ff-only og slet den med -d (kun arbejde/...)",
      "parametre": {
        "gren": {
          "moenster": "^arbejde/[A-Za-z0-9._-]+$",
          "paakraevet": true
        }
      },
      "trin": [
        {
          "cmd": "git",
          "args": [
            "switch",
            "main"
          ]
        },
        {
          "cmd": "git",
          "args": [
            "merge",
            "--ff-only",
            "{gren}"
          ]
        },
        {
          "cmd": "git",
          "args": [
            "branch",
            "-d",
            "{gren}"
          ]
        }
      ],
      "skriver": true,
      "forkontrol": [
        "ingen_netlify_gren"
      ]
    },
    "git_skift_main": {
      "beskrivelse": "git switch main (kun hvis arbejdstræet er rent)",
      "trin": [
        {
          "cmd": "git",
          "args": [
            "switch",
            "main"
          ]
        }
      ],
      "skriver": true,
      "forkontrol": [
        "rent_trae"
      ]
    },
    "git_push": {
      "beskrivelse": "git push origin main (kun fra main; afvises hvis det der pushes rører apps/netlify-prod/; ingen flag, ingen andre grene)",
      "trin": [
        {
          "cmd": "git",
          "args": [
            "push",
            "origin",
            "main"
          ]
        }
      ],
      "skriver": true,
      "tidsgraenseSek": 90,
      "forkontrol": [
        "paa_main",
        "ingen_netlify_push"
      ]
    },
    "tjek_hashes": {
      "beskrivelse": "Tjek de fem databasers hashes (node tools/tjek/db-hashes.mjs)",
      "laas": [
        "tools/tjek/db-hashes.mjs"
      ],
      "trin": [
        {
          "cmd": "node",
          "args": [
            "tools/tjek/db-hashes.mjs"
          ]
        }
      ]
    },
    "node_test": {
      "beskrivelse": "Kør én testfil med node --test (kun *.test.mjs under tools/ eller statistik/scripts/)",
      "parametre": {
        "fil": {
          "moenster": "^(tools|statistik/scripts)/[A-Za-z0-9_./-]+\\.test\\.mjs$",
          "forbyd": "\\.\\.",
          "paakraevet": true,
          "repoSti": true
        }
      },
      "trin": [
        {
          "cmd": "node",
          "args": [
            "--test",
            "{fil}"
          ]
        }
      ]
    },
    "kort_koer": {
      "beskrivelse": "ADVARSEL: Codex kører med fuld adgang (danger-full-access) inde i kørslen; serveren begrænser kun hvornår og med hvilke parametre den startes. Kører i baggrunden, ét job ad gangen. Uden commit, netværk og DB-ændring.",
      "baggrund": true,
      "tidsgraenseSek": 6000,
      "laas": [
        "tools/koer-kort.ps1"
      ],
      "parametre": {
        "kort": {
          "moenster": "^\\d{1,3}$",
          "paakraevet": true
        },
        "toer": {
          "type": "boolean",
          "beskrivelse": "Tørkørsel: viser kun hvad der ville ske"
        },
        "model": {
          "moenster": "^[A-Za-z0-9._-]+$"
        },
        "indsats": {
          "moenster": "^(low|medium|high)$"
        }
      },
      "trin": [
        {
          "cmd": "powershell",
          "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "tools/koer-kort.ps1",
            "-Kort",
            "{kort}",
            {
              "naar": "toer",
              "vaerdi": [
                "-Toer"
              ]
            },
            {
              "naar": "model",
              "vaerdi": [
                "-Model",
                "{model}"
              ]
            },
            {
              "naar": "indsats",
              "vaerdi": [
                "-Indsats",
                "{indsats}"
              ]
            }
          ]
        }
      ]
    },
    "kort_koer_net": {
      "beskrivelse": "NETVÆRKSKORT. TILLIDSBASERET UDLØSER, IKKE EN SIKKERHEDSBARRIERE: Codex kører med fuld adgang (danger-full-access) inde i kørslen. Kun kort, hvis præcise indhold (SHA-256, verificeret af runneren efter dens git pull) Christoffer har godkendt i net-kort.json, kan startes, og -TillavDbAendring sendes aldrig. Netværksbudget og databaseforbud er regler i kortet, ikke tekniske grænser. Kører i baggrunden, ét job ad gangen, uden commit.",
      "baggrund": true,
      "tidsgraenseSek": 6000,
      "laas": [
        "tools/koer-kort.ps1",
        "@net-kort.json"
      ],
      "parametre": {
        "kort": {
          "moenster": "^\\d{1,3}$",
          "paakraevet": true
        },
        "toer": {
          "type": "boolean",
          "beskrivelse": "Tørkørsel: viser kun hvad der ville ske"
        },
        "model": {
          "moenster": "^[A-Za-z0-9._-]+$",
          "tilladte": [
            "gpt-6-luna"
          ]
        },
        "indsats": {
          "moenster": "^(low|medium|high)$"
        }
      },
      "trin": [
        {
          "cmd": "powershell",
          "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "tools/koer-kort.ps1",
            "-Kort",
            "{kort}",
            "-TillavNetvaerk",
            {
              "naar": "netHash",
              "vaerdi": [
                "-ForventetKortHash",
                "{netHash}"
              ]
            },
            {
              "naar": "toer",
              "vaerdi": [
                "-Toer"
              ]
            },
            {
              "naar": "model",
              "vaerdi": [
                "-Model",
                "{model}"
              ]
            },
            {
              "naar": "indsats",
              "vaerdi": [
                "-Indsats",
                "{indsats}"
              ]
            }
          ]
        }
      ],
      "net": true
    }
  },
  "indbyggede": {
    "net_godkend": {
      "beskrivelse": "Godkend et netværkskort til kort_koer_net. Uden sha256: forhåndsvisning (hash + Netværk-linje) og intet godkendes. Med sha256 (mindst 12 tegn): godkender præcis den version og genlåser net-kort.json. Kald kun efter at Christoffer i chatten har sagt ja til netop dette kort. Kort der skriver database eller rører apps/netlify-prod/ kan ikke godkendes her.",
      "parametre": {
        "kort": {
          "moenster": "^\\d{1,3}$",
          "paakraevet": true
        },
        "sha256": {
          "moenster": "^[0-9a-fA-F]{12,64}$",
          "beskrivelse": "Kortets hash (mindst 12 tegn) fra forhåndsvisningen"
        }
      }
    },
    "net_traek": {
      "beskrivelse": "Træk godkendelsen af et netværkskort tilbage og genlås net-kort.json",
      "parametre": {
        "kort": {
          "moenster": "^\\d{1,3}$",
          "paakraevet": true
        }
      }
    },
    "git_flyt_kort": {
      "beskrivelse": "git mv af et kort fra work/future/ til work/aabne/ (kræver ren main). Flytningen er staged; commit bagefter med git_commit.",
      "parametre": {
        "kort": {
          "moenster": "^\\d{1,3}$",
          "paakraevet": true
        }
      }
    }
  },
  "blokeredeKort": [
    "163",
    "169",
    "175",
    "025",
    "026",
    "028",
    "029",
    "178",
    "180"
  ],
  "maxNetKald": 400
}
